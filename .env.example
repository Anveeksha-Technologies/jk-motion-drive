# Copy to .env.local for local development, and set the same keys in the
# Vercel project settings for preview/production.
#
# .env.local is machine-local and gitignored — never commit it.

# Canonical origin, no trailing slash.
#
# Drives canonical URLs, OpenGraph URLs, sitemap.xml, robots.txt and the links
# inside public/llms.txt. Leave unset to fall back to the production domain
# (https://www.jkmotiondrive.com).
#
# Set this on preview deployments too, otherwise previews advertise production
# URLs as their canonical and can deindex the real pages.
NEXT_PUBLIC_SITE_URL=https://www.jkmotiondrive.com

# Enquiry form endpoint (FormSubmit).
#
# Leave empty and the form keeps its demo behaviour: it validates, shows the
# success banner and sends nothing. Set it and the form performs a normal POST
# to this URL.
#
# FormSubmit gives you a URL of the form:
#   https://formsubmit.co/sales@jkmotiondrive.com     (email in the URL)
#   https://formsubmit.co/<random-token>              (after activation - preferred,
#                                                      it keeps the address out of the HTML)
#
# Activate once by submitting the form a first time and clicking the link
# FormSubmit emails you, then swap the address for the token it gives back.
#
# Confirmed provider: formsubmit.co. Nothing in the code is FormSubmit-specific
# beyond the underscore-prefixed control fields (_subject, _next, _captcha,
# _template, _honey) in components/ContactForm.tsx, so any endpoint accepting a
# normal form POST would also work.
NEXT_PUBLIC_FORMSUBMIT_ENDPOINT=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
#
# Leave empty and no analytics script is emitted at all — and the cookie notice
# stays hidden too, since with no tag there are no cookies to disclose. Set it in
# Vercel's production environment only, so local and preview traffic stays out of
# the property.
#
# Analytics is additionally gated on cookie consent at runtime; see
# lib/consent.ts and components/CookieConsent.tsx.
NEXT_PUBLIC_GA_ID=
